{
  "name": "build_dataset",
  "nodes": [
    {
      "id": "build",
      "type": "custom",
      "position": {
        "x": 0,
        "y": 0
      },
      "data": {
        "label": "Check, then build (silver > gold > publish)",
        "componentId": "code.shell",
        "properties": {
          "shell": "powershell",
          "code": ".\\.venv\\Scripts\\python.exe -m critical_buildings check; if ($LASTEXITCODE -eq 0) { .\\.venv\\Scripts\\python.exe -m critical_buildings run --type candidate --notes 'built from Duckle' }; exit $LASTEXITCODE",
          "timeoutMs": 7200000
        }
      }
    },
    {
      "id": "build_ok",
      "type": "transform",
      "position": {
        "x": 220,
        "y": 0
      },
      "data": {
        "label": "Build succeeded",
        "componentId": "xf.assert",
        "properties": {
          "predicate": "exit_code = 0",
          "message": "Build succeeded: the step failed - see its stdout/stderr in the run receipt"
        }
      }
    },
    {
      "id": "log",
      "type": "sink",
      "position": {
        "x": 440,
        "y": 0
      },
      "data": {
        "label": "Write build log",
        "componentId": "snk.csv",
        "properties": {
          "path": "data/duckle/last_build.csv"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "build",
      "target": "build_ok"
    },
    {
      "id": "e2",
      "source": "build_ok",
      "target": "log"
    }
  ]
}