        "y": 0
      },
      "data": {
        "label": "Fetch succeeded",
        "componentId": "xf.assert",
        "properties": {
          "predicate": "exit_code = 0",
          "message": "Fetch succeeded: the step failed - see its stdout/stderr in the run receipt"
        }
      }
    },
    {
      "id": "log",
      "type": "sink",
      "position": {
        "x": 440,
        "y": 0
      },
      "data": {
        "label": "Write fetch log",
        "componentId": "snk.csv",
        "properties": {
          "path": "data/duckle/last_fetch.csv"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
