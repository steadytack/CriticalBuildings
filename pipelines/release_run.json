{
  "name": "release_run",
  "nodes": [
    {
      "id": "release",
      "type": "custom",
      "position": {
        "x": 0,
        "y": 0
      },
      "data": {
        "label": "Release the current run",
        "componentId": "code.shell",
        "properties": {
          "shell": "powershell",
          "code": ".\\.venv\\Scripts\\python.exe -m critical_buildings release '${RELEASE_NAME}' --notes 'released from Duckle'",
          "timeoutMs": 7200000
        }
      }
    },
    {
      "id": "release_ok",
      "type": "transform",
      "position": {
        "x": 220,
        "y": 0
      },
      "data": {
        "label": "Release succeeded",
        "componentId": "xf.assert",
        "properties": {
          "predicate": "exit_code = 0",
          "message": "Release succeeded: the step failed - see its stdout/stderr in the run receipt"
        }
      }
    },
    {
      "id": "log",
      "type": "sink",
      "position": {
        "x": 440,
        "y": 0
      },
      "data": {
        "label": "Write release log",
        "componentId": "snk.csv",
        "properties": {
          "path": "data/duckle/last_release.csv"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "release",
      "target": "release_ok"
    },
    {
      "id": "e2",
      "source": "release_ok",
      "target": "log"
    }
  ],
  "params": [
    {
      "name": "RELEASE_NAME",
      "type": "string",
      "default": ""
    }
  ]
}